  "operational": {
    "threshold": 0.05,
    "rule": "forecast_risk >= 0.05"
  },
  "runtime_requirement": {
    "input": "5 consecutive 10-second network states",
    "features_per_state": 45,
    "scaler": "training StandardScaler",
    "output": "six risk scores"
  },
  "deployment_note": "Raw network packets must first be converted into the exact 45-feature 10-second state schema."
